{
  "name": "enarm-contraste",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare:study": "uv run python scripts/build_full_decks.py && uv run python scripts/verify_full_library.py",
    "prebuild": "npm run prepare:study",
    "build": "tsc --noEmit && vite build --config app/vite.config.ts && npm run build:server",
    "build:server": "vite build --config server/vite.config.ts",
    "preview": "node scripts/dev.mjs --preview",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test": "npm run test:unit && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  }
}
